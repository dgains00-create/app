@page
@model DMO.Web.Pages.Administration.Users.ListModel
@{
    ViewData["Title"] = "User administration";
}
<link rel="stylesheet" href="~/css/dmo-admin-users.css" asp-append-version="true" />

<p><a asp-page="Create">Create user</a></p>

<form method="post" action="/auth/logout" class="row">
    <button type="submit">Terminar sessão</button>
</form>

@if (TempData["message"] is string message)
{
    <div class="msg ok">@message</div>
}
@if (TempData["error"] is string error)
{
    <div class="msg err">@error</div>
}

<table>
    <thead>
        <tr>
            <th>Name</th>
            <th>Company number</th>
            <th>Email</th>
            <th>Role</th>
            <th>State</th>
            <th>Template</th>
            <th>Version</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var user in Model.Users)
    {
        <tr>
            <td>@user.Name</td>
            <td>@user.CompanyNumber</td>
            <td>@user.Email</td>
            <td>@user.Role</td>
            <td>
                @if (user.Active)
                {
                    <span class="badge on">active</span>
                }
                else
                {
                    <span class="badge off">inactive</span>
                }
            </td>
            <td>@(user.TemplateName ?? "—")</td>
            <td>@user.Version</td>
            <td><a asp-page="Edit" asp-route-id="@user.UserId">Details / edit</a></td>
        </tr>
    }
    </tbody>
</table>