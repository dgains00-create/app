@page "{id:guid}"
@model DMO.Web.Pages.Administration.Users.ResetPasswordModel
@{
    ViewData["Title"] = "Initiate password reset";
    var ficha = Model.Ficha!;
}
<link rel="stylesheet" href="~/css/dmo-admin-users.css" asp-append-version="true" />

<div asp-validation-summary="All" class="msg err"></div>

<p>
    <strong>Confirm password-reset for</strong> @ficha.Name (@ficha.CompanyNumber).
</p>
<p>
    The provider will send a recovery link to the carrier email (@ficha.Email).
    The user chooses the new password through the provider flow. The current password is never
    read or displayed, and no reset token is stored by the application.
</p>

<form method="post">
    <input asp-for="ExpectedVersion" type="hidden" />
    <div class="row">
        <button type="submit">Initiate password reset</button>
        <a asp-page="Edit" asp-route-id="@ficha.UserId">Cancel</a>
    </div>
</form>