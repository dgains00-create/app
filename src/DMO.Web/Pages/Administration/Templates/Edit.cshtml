@page "{id:guid}"
@model DMO.Web.Pages.Administration.Templates.EditModel
@{
    ViewData["Title"] = "Template details";
    var ficha = Model.Ficha!;
}
<link rel="stylesheet" href="~/css/dmo-admin-templates.css" asp-append-version="true" />

<div asp-validation-summary="All" class="msg err"></div>

@if (TempData["message"] is string message)
{
    <div class="msg ok">@message</div>
}
@if (TempData["error"] is string error)
{
    <div class="msg err">@error</div>
}

<form method="post">
    <input asp-for="EditExpectedVersion" type="hidden" />

    <label class="label">Name</label>
    <input asp-for="EditName" class="field" autocomplete="off" />

    <fieldset>
        <legend>Module composition (presentation order)</legend>

        @if (Model.AvailableModules.Count == 0)
        {
            <p class="empty">No Modules are available in this build.</p>
        }
        else
        {
            <table>
                <thead>
                    <tr><th>Select</th><th>Module</th><th>Destination</th><th>Order</th></tr>
                </thead>
                <tbody>
                @for (var index = 0; index < Model.AvailableModules.Count; index++)
                {
                    var definition = Model.AvailableModules[index];
                    var isSelected = Model.SelectedModuleIds.Contains(definition.Id.Value);
                    <tr>
                        <td><input type="checkbox" name="SelectedModuleIds" value="@definition.Id.Value" checked="@isSelected" /></td>
                        <td>@definition.DisplayName (@definition.Id.Value)</td>
                        <td>@(definition.DestinationId ?? "—")</td>
                        <td>
                            <input type="number" class="field order" name="ModuleOrder[@definition.Id.Value]"
                                   value="@(Model.ModuleOrder.TryGetValue(definition.Id.Value, out var order) ? order : index + 1)" min="1" />
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }

        @if (ficha.Modules.Any(module => module.State != DMO.Application.TemplateAdministration.TemplateModuleState.Available))
        {
            <p class="warn">
                Persisted Modules unavailable/invalid in this build are locked below: they are
                preserved unless you explicitly remove them (they never grant access until they
                become available, and they are never silently repaired).
            </p>
            <table>
                <thead>
                    <tr><th>Remove</th><th>Persisted Module</th><th>State</th><th>Order</th></tr>
                </thead>
                <tbody>
                @for (var index = 0; index < ficha.Modules.Count; index++)
                {
                    var module = ficha.Modules[index];
                    if (module.State == DMO.Application.TemplateAdministration.TemplateModuleState.Available)
                    {
                        continue;
                    }

                    <tr>
                        <td><input type="checkbox" name="RemoveModuleIds" value="@module.ModuleId" /></td>
                        <td>
                            <input type="hidden" name="SelectedModuleIds" value="@module.ModuleId" />
                            @module.ModuleId
                        </td>
                        <td class="badge off">
                            @(module.State == DMO.Application.TemplateAdministration.TemplateModuleState.KnownUnavailable
                                ? "unavailable in this build"
                                : "invalid identity")
                        </td>
                        <td>
                            <input type="number" class="field order" name="ModuleOrder[@module.ModuleId]"
                                   value="@(index + 1)" min="1" />
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </fieldset>

    <label class="label">Landing destination</label>
    @if (!ficha.LandingIsValid)
    {
        <p class="warn">
            The persisted landing (@ficha.LandingDestinationId) is not represented by any
            selected available Module destination. It must be corrected or removed explicitly —
            it will not be saved as-is.
        </p>
    }
    <select asp-for="EditLandingDestinationId" class="field">
        <option value="">No landing</option>
        @foreach (var option in Model.LandingOptions)
        {
            <option value="@option">@option</option>
        }
    </select>

    <div class="row actions-inline">
        <button type="submit">Save template</button>
        <a asp-page="Delete" asp-route-id="@ficha.TemplateId" class="danger">Delete…</a>
        <a asp-page="List">Back to list</a>
    </div>
</form>

<fieldset>
    <legend>Associated users (@ficha.Users.Count)</legend>

    @if (ficha.Users.Count == 0)
    {
        <p class="empty">No users are associated with this template.</p>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>User</th>
                    <th>Company number</th>
                    <th>Role</th>
                    <th>State</th>
                    <th>Version</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var user in ficha.Users)
            {
                <tr>
                    <td>@user.Name</td>
                    <td>@user.CompanyNumber</td>
                    <td>@user.Role</td>
                    <td>
                        @if (user.Active)
                        {
                            <span class="badge on">active</span>
                        }
                        else
                        {
                            <span class="badge off">inactive</span>
                        }
                    </td>
                    <td>@user.Version</td>
                    <td>
                        <form method="post" asp-page-handler="RemoveUser" class="inline">
                            <input type="hidden" name="RemoveUserId" value="@user.UserId" />
                            <input type="hidden" name="RemoveUserVersion" value="@user.Version" />
                            <button type="submit">Remove</button>
                        </form>
                        <form method="post" asp-page-handler="Reassign" class="inline">
                            <input type="hidden" name="ReassignUserId" value="@user.UserId" />
                            <input type="hidden" name="ReassignUserVersion" value="@user.Version" />
                            <select name="ReassignTargetTemplateId" class="field">
                                @foreach (var option in Model.TemplateOptions.Where(option => option.TemplateId != ficha.TemplateId))
                                {
                                    <option value="@option.TemplateId">@option.Name</option>
                                }
                            </select>
                            <button type="submit">Reassign</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</fieldset>

<fieldset>
    <legend>Assign a user</legend>
    @if (Model.AssignCandidates.Count == 0)
    {
        <p class="empty">All users are already associated with this template.</p>
    }
    else
    {
        <table>
            <thead>
                <tr><th>User</th><th>Company number</th><th>State</th><th></th></tr>
            </thead>
            <tbody>
            @foreach (var user in Model.AssignCandidates)
            {
                <tr>
                    <td>@user.Name</td>
                    <td>@user.CompanyNumber</td>
                    <td>
                        @if (user.Active)
                        {
                            <span class="badge on">active</span>
                        }
                        else
                        {
                            <span class="badge off">inactive</span>
                        }
                    </td>
                    <td>
                        <form method="post" asp-page-handler="Assign" class="inline">
                            <input type="hidden" name="AssignUserId" value="@user.UserId" />
                            <input type="hidden" name="AssignUserVersion" value="@user.Version" />
                            <button type="submit">Assign</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</fieldset>