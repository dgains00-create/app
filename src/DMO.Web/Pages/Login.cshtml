@page
@model LoginModel
@{
    ViewData["Title"] = "Iniciar sessão";
    Layout = "Shared/_PublicLayout";
}
<link rel="stylesheet" href="~/css/dmo-user-shell.css" asp-append-version="true" />

<section class="dmo-public-panel" aria-labelledby="login-title">
    <span class="dmo-eyebrow">Acesso seguro</span>
    <h1 id="login-title">Iniciar sessão</h1>
    <p class="dmo-public-hint">
        Introduza o e-mail (administração) ou o número de funcionário (operador) — nunca
        ambos — e a palavra-passe.
    </p>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <p class="dmo-form-error" role="alert">@Model.ErrorMessage</p>
    }

    <form method="post" class="dmo-login-form">
        <label asp-for="Email">E-mail (administração)</label>
        <input asp-for="Email" type="email" autocomplete="username" />

        <label asp-for="CompanyNumber">Número de funcionário (operador)</label>
        <input asp-for="CompanyNumber" type="text" autocomplete="username" />

        <label asp-for="Password">Palavra-passe</label>
        <input asp-for="Password" type="password" autocomplete="current-password" required />

        <button type="submit" class="dmo-button">Entrar</button>
    </form>
</section>