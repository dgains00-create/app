@model NavigationPresentation
<nav class="dmo-primary-nav" aria-label="Destinos principais">
    <div class="dmo-primary-nav-scroll">
        @foreach (var destination in Model.LiveDestinations)
        {
            <a class="dmo-primary-link @(destination.IsCurrent ? "is-current" : null)"
               href="@destination.Href"
               aria-current="@(destination.IsCurrent ? "page" : null)">@destination.Label</a>
        }
        @if (Model.LiveDestinations.Count == 0)
        {
            <span class="dmo-nav-empty">Sem destinos operacionais disponíveis</span>
        }
    </div>
</nav>
