@page "/boquilhas/novo"
@model DMO.Web.Pages.Boquilhas.NovoModel
@using DMO.Web.Frontend.Shared.Contracts
@{
    ViewData["Title"] = "Boquilhas — Novo";
}
<partial name="~/Pages/Shared/Components/_SharedComponentAssets.cshtml" />
<link rel="stylesheet" href="~/css/dmo-boquilhas.css" asp-append-version="true" />
<script src="~/js/dmo-boquilhas.js" defer></script>

@*
    P2-T07 Novo surface (OWNER CLARIFICATION).

    Fixed desktop composition at the binding 1366 × 768 viewport; no breakpoint variant, no card
    conversion, no required-field hiding and no action relocation exists anywhere in this surface
    (AC-L1/L2).

    The register ALWAYS belongs to a REAL production: reference search → explicit production
    selection → Job On ficha with the BQ-context presence → (missing context: explicit associar BQ
    through IJobOnService; the shared Tool picker is the P2-T04 orchestration, BQ candidates only,
    never auto-selected) → "Criar registo" creates the REGISTER IDENTITY only — no Início, no
    initial quantity, no opening facts, no standalone flow (the register anchors a REAL bq_contexts
    row, created ONLY through IJobOnService).
*@
<section class="dmo-boquilhas" data-dmo-boquilhas-surface="novo" data-dmo-boquilhas-root="true">

    @* ---- Production selection: reference search → productions → Job On read ---------------- *@
    <div class="dmo-boquilhas__region" data-dmo-boquilhas-region="production" aria-label="Contexto de produção">
        <div class="dmo-boquilhas__search" data-dmo-production-search="true">
            <label class="dmo-boquilhas__label" for="dmo-boquilhas-reference-search">Referência</label>
            <input class="dmo-boquilhas__input" id="dmo-boquilhas-reference-search" type="text"
                   value="@Model.JobOnId?.ToString() ?? string.Empty" data-dmo-production-reference="true" />
            <button type="button" class="dmo-boquilhas__button" data-dmo-production-search-submit="true">Pesquisar produções</button>
        </div>

        <div class="dmo-boquilhas__productions" data-dmo-productions="true" hidden>
            <p class="dmo-boquilhas__empty" data-dmo-productions-empty="true" hidden>Sem produções para esta referência.</p>
        </div>

        <div class="dmo-boquilhas__jobon" data-dmo-jobon-facts="true" hidden>
            <p class="dmo-boquilhas__jobon-present" data-dmo-bq-present="true" hidden>
                Contexto BQ presente — produção associada.
            </p>
            <p class="dmo-boquilhas__jobon-missing" data-dmo-bq-missing="true" hidden>
                Contexto BQ em falta para esta produção.
            </p>
            <button type="button"
                    class="dmo-boquilhas__button"
                    data-dmo-associate-bq="true"
                    disabled
                    hidden>Associar BQ</button>

            @* ---- §34.1 rule 2, the Job-On-incoming direction: pending registers of the SAME tool.
               The adapter fetches /boquilhas/pending-registers?bqId= when the BQ context is present
               and presents each candidate with an EXPLICIT per-row confirmation (nunca automático). *@
            <div class="dmo-boquilhas__pending" data-dmo-pending-registers="true" hidden>
                <h3 class="dmo-boquilhas__title">Registos pré-JobOn da mesma ferramenta</h3>
                <p class="dmo-boquilhas__hint">
                    Existem registos iniciados antes desta produção com a mesma ferramenta BQ (o mesmo
                    tool_id). Pode associar um registo existente a esta produção — com confirmação
                    explícita — ou criar um registo novo.
                </p>
                <p class="dmo-boquilhas__empty" data-dmo-pending-registers-empty="true" hidden>
                    Sem registos pré-JobOn desta ferramenta.
                </p>
                <div data-dmo-pending-register-rows="true"></div>
            </div>
        </div>
    </div>

    @* ---- BQ Tool via the SHARED picker (only when the BQ context must be created) ---------- *@
    <div class="dmo-boquilhas__region" data-dmo-boquilhas-region="tool" aria-label="Ferramenta BQ">
        @if (Model.ToolPicker is { } picker)
        {
            ViewData["ToolPickerRegionId"] = "dmo-boquilhas-picker";
            <partial name="~/Pages/Shared/Components/_ToolPicker.cshtml" model="picker" view-data="ViewData" />
        }

        @* The adapter's own opaque-key → canonical tool_id map for this interaction. *@
        <span class="dmo-boquilhas__candidate-map" data-dmo-boquilhas-candidate-map="true" hidden></span>

        @* The contextual Tool create subflow (posts POST /ferramentas/tools; returns to THIS origin) *@
        <fieldset class="dmo-boquilhas__tool-create"
                  data-dmo-boquilhas-tool-create-panel="true"
                  hidden>
            <legend class="dmo-boquilhas__legend">Criar ferramenta BQ</legend>
            <label class="dmo-boquilhas__label" for="dmo-boquilhas-tool-reference">Referência</label>
            <input class="dmo-boquilhas__input" id="dmo-boquilhas-tool-reference" type="text" data-dmo-boquilhas-tool-field="reference" />
            <label class="dmo-boquilhas__label" for="dmo-boquilhas-tool-lot">Lote</label>
            <input class="dmo-boquilhas__input" id="dmo-boquilhas-tool-lot" type="text" data-dmo-boquilhas-tool-field="lot" />
            <label class="dmo-boquilhas__label" for="dmo-boquilhas-tool-processo">Processo</label>
            <select class="dmo-boquilhas__input" id="dmo-boquilhas-tool-processo" data-dmo-boquilhas-tool-field="processo">
                <option value="">—</option>
                <option value="NNPB">NNPB</option>
                <option value="PS">PS</option>
            </select>
            <label class="dmo-boquilhas__label" for="dmo-boquilhas-tool-quantity">Quantidade</label>
            <input class="dmo-boquilhas__input" id="dmo-boquilhas-tool-quantity" type="number" min="0" data-dmo-boquilhas-tool-field="quantity" />
            <span class="dmo-boquilhas__label">Máquinas compatíveis</span>
            <span class="dmo-boquilhas__machines" data-dmo-boquilhas-tool-machines="true">
                @foreach (var machine in DMO.Domain.Tools.MachineCode.All)
                {
                    <label class="dmo-boquilhas__machine">
                        <input type="checkbox" value="@machine.Value" data-dmo-boquilhas-tool-machine="@machine.Value" />
                        @machine.Value
                    </label>
                }
            </span>
            <p class="dmo-boquilhas__error" data-dmo-boquilhas-tool-create-error="true" hidden></p>
            <span class="dmo-boquilhas__tool-create-actions">
                <button type="button" class="dmo-boquilhas__button" data-dmo-boquilhas-tool-create-submit="true">Criar ferramenta</button>
                <button type="button" class="dmo-boquilhas__button" data-dmo-boquilhas-tool-create-cancel="true">Cancelar</button>
            </span>
        </fieldset>
    </div>

    @* ---- Register creation: the IDENTITY only — no quantity, no opening facts -------------- *@
    <div class="dmo-boquilhas__region" data-dmo-boquilhas-region="create" aria-label="Criar registo">
        <fieldset class="dmo-boquilhas__entry" data-dmo-create-register="true">
            <legend class="dmo-boquilhas__legend">Criar registo de Boquilhas</legend>
            <p class="dmo-boquilhas__hint">
                O registo associa os movimentos a esta produção; não é criado qualquer movimento de
                quantidade nesta ação.
            </p>
            <span class="dmo-boquilhas__actions">
                <button type="button" class="dmo-boquilhas__button" data-dmo-create-submit="true">Criar registo</button>
            </span>
        </fieldset>

        @* ---- §34.1 rule 1: the TRANSITIONAL pré-JobOn branch (the provisional tool_id anchor) -*@
        <fieldset class="dmo-boquilhas__entry" data-dmo-create-pending="true">
            <legend class="dmo-boquilhas__legend">Criar registo pré-JobOn</legend>
            <p class="dmo-boquilhas__hint">
                Sem produção associada: o registo fica provisoriamente ancorado na ferramenta BQ
                (tool_id) selecionada na lista de ferramentas. Quando existir um contexto de produção
                com a mesma ferramenta, o registo é apresentado para associação — com confirmação.
            </p>
            <span class="dmo-boquilhas__actions">
                <button type="button" class="dmo-boquilhas__button" data-dmo-create-pending-submit="true">Criar registo pré-JobOn</button>
            </span>
        </fieldset>

        @* Page-owned adapter state: the REAL production context selection *@
        <input type="hidden" data-dmo-selected-tool="true" />
        <input type="hidden" data-dmo-selected-bq="true" />
        <input type="hidden" data-dmo-selected-jobon="true" data-dmo-selected-jobon-version="0" />

        @* Page-owned failure surface (conflict = message + explicit reload recovery, D2) *@
        <div class="dmo-boquilhas__state" data-dmo-boquilhas-state="true" hidden></div>
    </div>
</section>