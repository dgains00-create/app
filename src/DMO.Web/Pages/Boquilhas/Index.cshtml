@page "/boquilhas"
@model DMO.Web.Pages.Boquilhas.IndexModel
@using DMO.Web.Frontend.Shared.Contracts
@{
    ViewData["Title"] = "Boquilhas — Registo";
}
<partial name="~/Pages/Shared/Components/_SharedComponentAssets.cshtml" />
<link rel="stylesheet" href="~/css/dmo-boquilhas.css" asp-append-version="true" />
<script src="~/js/dmo-boquilhas.js" defer></script>

@*
    P2-T07 Registo surface — the production movement register (OWNER CLARIFICATION).

    Fixed desktop composition at the binding 1366 × 768 viewport: the regions keep their structural
    order at every desktop width; smaller windows scroll; the wide register list uses local
    keyboard-reachable overflow. No breakpoint variant, no card conversion, no required-column
    hiding and no action relocation exists anywhere in this surface (AC-L1/L2).

    The core screen focuses on: production context, Boquilhas movements, add movement, edit
    selected movement. Movement vocabulary shown to users: Saída, Entrada, Entrada sem reparação —
    no Início, no Irreparável, no active/closed state, no reopened state, and no close/reopen/
    opening-facts controls. Tables are selection surfaces: single click selects, double click
    opens, actions live OUTSIDE the tables — no per-row button grids. Every fact rendered is a
    REAL backend fact: the outstanding repair quantity is derived by replay (Σ Saída − Σ Entrada −
    Σ Entrada sem reparação; negative values visible, non-blocking) and the production context is
    the REAL Job On/BQ context. The mutating actions post to the accepted minimal-API routes
    through the page-owned adapter (dmo-boquilhas.js); backend validation is authoritative and a
    stale movement version enters the accepted conflict presentation with the explicit reload
    recovery (D2).
*@
<section class="dmo-boquilhas" data-dmo-boquilhas-surface="index" data-dmo-boquilhas-root="true">

    @* ---- Register list (production context + derived outstanding; selection/open arbitration) *@
    <div class="dmo-boquilhas__region" data-dmo-boquilhas-region="list" aria-label="Registos">
        <form class="dmo-boquilhas__filters" method="get" action="/boquilhas" data-dmo-boquilhas-filters="true">
            <label class="dmo-boquilhas__label" for="dmo-boquilhas-reference">Referência</label>
            <input class="dmo-boquilhas__input" id="dmo-boquilhas-reference" name="reference" type="text"
                   value="@Model.Reference" data-dmo-filter-reference="true" />
            <label class="dmo-boquilhas__label" for="dmo-boquilhas-lot">Lote</label>
            <input class="dmo-boquilhas__input" id="dmo-boquilhas-lot" name="lot" type="text"
                   value="@Model.Lot" data-dmo-filter-lot="true" />
            <button class="dmo-boquilhas__button" type="submit" data-dmo-boquilhas-filter-submit="true">Filtrar</button>
        </form>

        @if (Model.ValidationErrors.Count > 0)
        {
            <ul class="dmo-boquilhas__errors" role="alert" data-dmo-boquilhas-errors="true">
                @foreach (var error in Model.ValidationErrors)
                {
                    <li data-dmo-boquilhas-error="@error">@error</li>
                }
            </ul>
        }

        @if (Model.Registers is { } registers)
        {
            <div class="dmo-boquilhas__route-map" data-dmo-open-route-map="true" hidden>
                @foreach (var route in Model.OpenRoutes)
                {
                    <span data-dmo-open-route="@route.Key" data-dmo-open-href="@route.Href"></span>
                }
            </div>
            <partial name="~/Pages/Shared/Components/_DenseDataTable.cshtml" model="registers" />
        }
        else if (Model.ValidationErrors.Count == 0)
        {
            <p class="dmo-boquilhas__empty" data-dmo-boquilhas-empty="true">Sem registos de Boquilhas para apresentar.</p>
        }
    </div>

    @if (Model.Register is { } registerView)
    {
        var ficha = registerView.Ficha;

        @* ---- The opened register: production context + ledger + entry + edit ---------------- *@
        <div class="dmo-boquilhas__region" data-dmo-boquilhas-region="register" aria-label="Registo aberto"
             data-dmo-boquilhas-id="@ficha.BoquilhasId">

            <div class="dmo-boquilhas__ficha-head" data-dmo-boquilhas-ficha-head="true">
                <h2 class="dmo-boquilhas__title">
                    Boquilhas @ficha.BoquilhasId — @(ficha.Reference ?? (ficha.IsPending ? "pré-JobOn" : "(sem contexto)"))
                </h2>
                <a class="dmo-boquilhas__link" href="/boquilhas/definicoes">Definições</a>
            </div>

            @* Production context (REAL facts; the register belongs to this production always) *@
            <dl class="dmo-boquilhas__panel-facts" data-dmo-boquilhas-panel="true" aria-label="Contexto de produção">
                @if (ficha.Production is { } production)
                {
                    <div class="dmo-boquilhas__fact"><dt>Referência</dt><dd data-dmo-panel-reference="true">@production.Reference</dd></div>
                    <div class="dmo-boquilhas__fact"><dt>Produção</dt><dd data-dmo-panel-production="true">@production.ProductionNumber</dd></div>
                    <div class="dmo-boquilhas__fact"><dt>Máquina</dt><dd data-dmo-panel-machine="true">@production.Machine</dd></div>
                    <div class="dmo-boquilhas__fact"><dt>Data de produção</dt><dd data-dmo-panel-production-date="true">@(production.ProductionDate?.ToString("yyyy-MM-dd") ?? "—")</dd></div>
                }
                else if (ficha.PendingTool is { } pendingTool)
                {
                    <div class="dmo-boquilhas__fact"><dt>Estado</dt><dd data-dmo-pending-state="true">Registo pré-JobOn — sem produção associada</dd></div>
                    <div class="dmo-boquilhas__fact"><dt>Ferramenta BQ (âncora provisória)</dt><dd data-dmo-pending-tool="true">@pendingTool.ToolReference — lote @pendingTool.ToolLot</dd></div>
                }
                else
                {
                    <p class="dmo-boquilhas__empty">Contexto de produção indisponível.</p>
                }
                @if (ficha.Anchor is { } anchor)
                {
                    <div class="dmo-boquilhas__fact"><dt>Ferramenta BQ (fixada)</dt><dd data-dmo-frozen-triple="true">@anchor.FrozenToolReference — lote @anchor.FrozenToolLot</dd></div>
                }
            </dl>

            @* Derived outstanding (replay; negative values visible, non-blocking) *@
            <dl class="dmo-boquilhas__facts" data-dmo-boquilhas-facts="true">
                <div class="dmo-boquilhas__fact"><dt>Pendente de reparação</dt><dd data-dmo-outstanding="true" class="@(ficha.Outstanding < 0 ? "dmo-boquilhas__negative" : "")">@ficha.Outstanding</dd></div>
            </dl>

            @* ---- §34: the human-confirmed association panel of a PENDING register ----------------
               The candidates are the REAL bq_contexts rows whose tool_id equals the pending anchor;
               the operator confirms each association explicitly (never automatic; the anchor must
               match by the same UUID; máquina/linha is only context, never identity). *@
            @if (ficha.IsPending)
            {
                <div class="dmo-boquilhas__region" data-dmo-association-panel="true" aria-label="Associar à produção"
                     data-dmo-boquilhas-version="@ficha.Version">
                    <h3 class="dmo-boquilhas__title">Associar à produção</h3>
                    <p class="dmo-boquilhas__hint">
                        Este registo foi iniciado antes de existir um Job On. Quando existir uma produção com a
                        mesma ferramenta BQ (o mesmo tool_id), a associação é apresentada aqui e exige
                        confirmação do operador — nunca é automática. O registo mantém o mesmo número e todo
                        o histórico de movimentos.
                    </p>
                    <div class="dmo-boquilhas__candidates" data-dmo-association-candidates="true"></div>
                </div>
            }

            @* Movement ledger (single click selects; double click opens its edit/detail) *@
            <div class="dmo-boquilhas__ledger-scroll" role="region" tabindex="0" aria-label="Movimentos">
                <table class="dmo-boquilhas__ledger" data-dmo-movement-table="true">
                    <thead>
                        <tr>
                            <th>Movimento</th>
                            <th>Quantidade</th>
                            <th>Saldo</th>
                            <th>Data de negócio</th>
                            <th>Registado em</th>
                            <th>Reparador</th>
                            <th>Linha</th>
                            <th>Operador</th>
                            <th>Observações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var movement in ficha.Movements)
                        {
                            <tr tabindex="0"
                                data-dmo-movement-row="@movement.MovementId"
                                data-dmo-movement-type="@movement.MovementType"
                                data-dmo-movement-version="@movement.Version"
                                data-dmo-movement-quantity="@movement.Quantity"
                                data-dmo-movement-business-date="@movement.BusinessDate.ToString("yyyy-MM-dd")"
                                data-dmo-movement-machine="@(movement.Machine ?? "")"
                                data-dmo-movement-repairer="@(movement.RepairerId?.ToString() ?? "")"
                                data-dmo-movement-observations="@(movement.Observations ?? "")">
                                <td>@registerView.Label(movement.MovementType)</td>
                                <td>@movement.Quantity</td>
                                <td class="@(movement.Saldo < 0 ? "dmo-boquilhas__negative" : "")">@movement.Saldo</td>
                                <td>@movement.BusinessDate.ToString("yyyy-MM-dd")</td>
                                <td>@movement.RecordedAt.ToString("yyyy-MM-dd HH:mm") UTC</td>
                                <td>@(movement.RepairerId?.ToString() ?? "—")</td>
                                <td>@(movement.Machine ?? "—")</td>
                                <td>@movement.RecordedByUserId</td>
                                <td>@(movement.Observations ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @* ---- Movement entry (the selector exposes EXACTLY the three types) -------------- *@
            <fieldset class="dmo-boquilhas__entry" data-dmo-movement-entry="true">
                <legend class="dmo-boquilhas__legend">Registar movimento</legend>
                <label class="dmo-boquilhas__label" for="dmo-boquilhas-movement-type">Tipo</label>
                <select class="dmo-boquilhas__input" id="dmo-boquilhas-movement-type" data-dmo-movement-field="type">
                    <option value="saida">Saída</option>
                    <option value="entrada">Entrada</option>
                    <option value="entrada_sem_reparacao">Entrada sem reparação</option>
                </select>
                <label class="dmo-boquilhas__label" for="dmo-boquilhas-movement-quantity">Quantidade</label>
                <input class="dmo-boquilhas__input" id="dmo-boquilhas-movement-quantity" type="number" min="1" value="1"
                       data-dmo-movement-field="quantity" />
                <label class="dmo-boquilhas__label" for="dmo-boquilhas-movement-date">Data de negócio</label>
                <input class="dmo-boquilhas__input" id="dmo-boquilhas-movement-date" type="date"
                       value="@DateTime.Today.ToString("yyyy-MM-dd")" data-dmo-movement-field="businessDate" />
                <label class="dmo-boquilhas__label" for="dmo-boquilhas-movement-machine">Máquina</label>
                <select class="dmo-boquilhas__input" id="dmo-boquilhas-movement-machine" data-dmo-movement-field="machine">
                    <option value="">—</option>
                    @foreach (var machine in DMO.Domain.Tools.MachineCode.All)
                    {
                        <option value="@machine.Value">@machine.Value</option>
                    }
                </select>
                <label class="dmo-boquilhas__label" for="dmo-boquilhas-movement-repairer">Reparador</label>
                <select class="dmo-boquilhas__input" id="dmo-boquilhas-movement-repairer" data-dmo-movement-field="repairer">
                    <option value="">—</option>
                    @foreach (var repairer in Model.Entry?.Repairers ?? [])
                    {
                        <option value="@repairer.RepairerId">@repairer.Name</option>
                    }
                </select>
                <label class="dmo-boquilhas__label" for="dmo-boquilhas-movement-observations">Observações</label>
                <input class="dmo-boquilhas__input" id="dmo-boquilhas-movement-observations" type="text"
                       data-dmo-movement-field="observations" />
                @if (Model.Entry is { } entry)
                {
                    <div class="dmo-boquilhas__resolutions" data-dmo-resolutions="true" hidden>
                        @foreach (var assignment in entry.Assignments)
                        {
                            <span data-dmo-assignment="@assignment.Machine"
                                  data-dmo-assignment-repairer="@(assignment.RepairerId?.ToString() ?? "")"
                                  data-dmo-assignment-unavailable="@(assignment.AssignmentUnavailable.ToString().ToLowerInvariant())"></span>
                        }
                    </div>
                }
                <span class="dmo-boquilhas__actions">
                    <button type="button" class="dmo-boquilhas__button" data-dmo-movement-submit="true">Registar movimento</button>
                </span>
            </fieldset>

            @* Page-owned failure surface (conflict = message + explicit reload recovery, D2) *@
            <div class="dmo-boquilhas__state" data-dmo-boquilhas-state="true" hidden></div>
        </div>

        @* ---- Movement edit/detail (opened by double click on the ledger; AuditTrail) -------- *@
        @if (Model.Detail is { } detail)
        {
            <div class="dmo-boquilhas__region" data-dmo-boquilhas-region="detail" aria-label="Editar movimento"
                 data-dmo-edit-movement-id="@detail.Movement.MovementId"
                 data-dmo-edit-movement-version="@detail.Movement.Version">
                <h3 class="dmo-boquilhas__title">Editar movimento — @registerView.Label(detail.Movement.MovementType)</h3>
                <dl class="dmo-boquilhas__facts">
                    <div class="dmo-boquilhas__fact"><dt>Registado em</dt><dd>@detail.Movement.RecordedAt.ToString("yyyy-MM-dd HH:mm") UTC</dd></div>
                    <div class="dmo-boquilhas__fact"><dt>Operador</dt><dd>@detail.Movement.RecordedByUserId</dd></div>
                </dl>
                <fieldset class="dmo-boquilhas__entry" data-dmo-edit-form="true">
                    <label class="dmo-boquilhas__label" for="dmo-boquilhas-edit-quantity">Quantidade</label>
                    <input class="dmo-boquilhas__input" id="dmo-boquilhas-edit-quantity" type="number" min="1"
                           value="@detail.Movement.Quantity" data-dmo-edit-field="quantity" />
                    <label class="dmo-boquilhas__label" for="dmo-boquilhas-edit-date">Data de negócio</label>
                    <input class="dmo-boquilhas__input" id="dmo-boquilhas-edit-date" type="date"
                           value="@detail.Movement.BusinessDate.ToString("yyyy-MM-dd")" data-dmo-edit-field="businessDate" />
                    <label class="dmo-boquilhas__label" for="dmo-boquilhas-edit-machine">Máquina</label>
                    <select class="dmo-boquilhas__input" id="dmo-boquilhas-edit-machine" data-dmo-edit-field="machine">
                        <option value="">—</option>
                        @foreach (var machine in DMO.Domain.Tools.MachineCode.All)
                        {
                            <option value="@machine.Value" selected="@(detail.Movement.Machine == machine.Value)">@machine.Value</option>
                        }
                    </select>
                    <label class="dmo-boquilhas__label" for="dmo-boquilhas-edit-repairer">Reparador</label>
                    <select class="dmo-boquilhas__input" id="dmo-boquilhas-edit-repairer" data-dmo-edit-field="repairer">
                        <option value="">—</option>
                        @foreach (var repairer in Model.Entry?.Repairers ?? [])
                        {
                            <option value="@repairer.RepairerId" selected="@(detail.Movement.RepairerId == repairer.RepairerId)">@repairer.Name</option>
                        }
                    </select>
                    <label class="dmo-boquilhas__label" for="dmo-boquilhas-edit-observations">Observações</label>
                    <input class="dmo-boquilhas__input" id="dmo-boquilhas-edit-observations" type="text"
                           value="@(detail.Movement.Observations ?? "")" data-dmo-edit-field="observations" />
                    <span class="dmo-boquilhas__actions">
                        <button type="button" class="dmo-boquilhas__button" data-dmo-edit-submit="true">Guardar edição</button>
                    </span>
                </fieldset>
                <div class="dmo-boquilhas__trail" data-dmo-audit-trail="true">
                    <partial name="~/Pages/Shared/Components/_AuditTrail.cshtml" model="detail.Trail" />
                </div>
            </div>
        }
    }
</section>