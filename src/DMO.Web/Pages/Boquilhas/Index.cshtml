@page "/boquilhas"
@model DMO.Web.Pages.Boquilhas.IndexModel
@using DMO.Web.Frontend.Shared.Contracts
@{
    ViewData["Title"] = "Boquilhas — Registo";
    var stateFilterActive = Model.State is null or "active";
    var stateFilterClosed = Model.State == "closed";
}
<partial name="~/Pages/Shared/Components/_SharedComponentAssets.cshtml" />
<link rel="stylesheet" href="~/css/dmo-boquilhas.css" asp-append-version="true" />
<script src="~/js/dmo-boquilhas.js" defer></script>

@*
    P2-T07 Registo surface (contract §25.1 regions R1–R6, §23, §24.3).

    Fixed desktop composition at the binding 1366 × 768 viewport: the six regions keep their
    structural order at every desktop width; smaller windows scroll; the wide lot grid uses local
    keyboard-reachable overflow. No breakpoint variant, no card conversion, no required-column
    hiding and no action relocation exists anywhere in this surface (AC-L1/L2).

    Tables are selection surfaces: single click selects, double click opens the exact item, and
    actions live OUTSIDE the tables (DecisionBar) — no per-row action button grid (AC-H3).
    Every fact rendered is a REAL backend fact: the balance buckets are replay-derived at read
    time (never stored), the movement ledger carries the operator-editable business_date and the
    immutable recorded_at, the R6 contextual panel reads REAL production context when the aggregate
    is production-linked and ONLY the registered machine set when standalone — no simulated Job On
    machine/reference sidebar (AC-N5). The mutating actions post to the accepted minimal-API routes
    through the page-owned adapter (dmo-boquilhas.js); backend validation is authoritative and a
    stale version enters the accepted conflict presentation with the explicit reload recovery (D2).
*@
<section class="dmo-boquilhas" data-dmo-boquilhas-surface="index" data-dmo-boquilhas-root="true">

    @* ---- R1 — Lot grid (filters backend-applied; selection/open arbitration; actions outside) *@
    <div class="dmo-boquilhas__region" data-dmo-boquilhas-region="grid" aria-label="Grelha de lotes">
        <form class="dmo-boquilhas__filters" method="get" action="/boquilhas" data-dmo-boquilhas-filters="true">
            <label class="dmo-boquilhas__label" for="dmo-boquilhas-reference">Referência</label>
            <input class="dmo-boquilhas__input" id="dmo-boquilhas-reference" name="reference" type="text"
                   value="@Model.Reference" data-dmo-filter-reference="true" />
            <label class="dmo-boquilhas__label" for="dmo-boquilhas-lot">Lote</label>
            <input class="dmo-boquilhas__input" id="dmo-boquilhas-lot" name="lot" type="text"
                   value="@Model.Lot" data-dmo-filter-lot="true" />
            <label class="dmo-boquilhas__label" for="dmo-boquilhas-machine">Máquina</label>
            <input class="dmo-boquilhas__input" id="dmo-boquilhas-machine" name="machine" type="text"
                   value="@Model.Machine" data-dmo-filter-machine="true" />
            <label class="dmo-boquilhas__label" for="dmo-boquilhas-state">Estado</label>
            <select class="dmo-boquilhas__input" id="dmo-boquilhas-state" name="state" data-dmo-filter-state="true">
                <option value="active" selected="@stateFilterActive">Ativo</option>
                <option value="closed" selected="@stateFilterClosed">Fechado</option>
            </select>
            <button class="dmo-boquilhas__button" type="submit" data-dmo-boquilhas-filter-submit="true">Filtrar</button>
        </form>

        @if (Model.ValidationErrors.Count > 0)
        {
            <ul class="dmo-boquilhas__errors" role="alert" data-dmo-boquilhas-errors="true">
                @foreach (var error in Model.ValidationErrors)
                {
                    <li data-dmo-boquilhas-error="@error">@error</li>
                }
            </ul>
        }

        @if (Model.LotGrid is { } grid)
        {
            <div class="dmo-boquilhas__route-map" data-dmo-open-route-map="true" hidden>
                @foreach (var route in Model.OpenRoutes)
                {
                    <span data-dmo-open-route="@route.Key" data-dmo-open-href="@route.Href"></span>
                }
            </div>
            <partial name="~/Pages/Shared/Components/_DenseDataTable.cshtml" model="grid" />
        }
        else if (Model.ValidationErrors.Count == 0)
        {
            <p class="dmo-boquilhas__empty" data-dmo-boquilhas-empty="true">Sem registos de Boquilhas para apresentar.</p>
        }
    </div>

    @if (Model.Ficha is { } fichaView)
    {
        var ficha = fichaView.Ficha;
        var fichaStatus = RecordStatusPresentation.Create(
            ficha.State == "closed" ? "Fechado" : "Ativo",
            ficha.State == "closed" ? StatusTone.Neutral : StatusTone.Success);

        @* ---- R2 — Aggregate register (anchor context, machines, opening facts, balance, ledger) *@
        <div class="dmo-boquilhas__region" data-dmo-boquilhas-region="ficha" aria-label="Registo aberto"
             data-dmo-boquilhas-id="@ficha.BoquilhasId" data-dmo-version="@Model.ObservedVersion">

            <div class="dmo-boquilhas__ficha-head" data-dmo-boquilhas-ficha-head="true">
                <h2 class="dmo-boquilhas__title">
                    Boquilhas @ficha.BoquilhasId —
                    @(ficha.Reference ?? "(sem contexto)")
                </h2>
                <partial name="~/Pages/Shared/Components/_RecordStatus.cshtml" model="fichaStatus" />
            </div>

            @* Anchor context: frozen BQ triple (production-linked, historical fact) or live Tool (standalone) *@
            @if (ficha.Anchor is { } anchor)
            {
                <dl class="dmo-boquilhas__anchor" data-dmo-boquilhas-anchor="true">
                    @if (ficha.IsProductionLinked)
                    {
                        <div class="dmo-boquilhas__fact"><dt>Ferramenta BQ (fixada)</dt><dd data-dmo-frozen-triple="true">@anchor.FrozenToolReference — lote @anchor.FrozenToolLot</dd></div>
                    }
                    else
                    {
                        <div class="dmo-boquilhas__fact"><dt>Ferramenta BQ</dt><dd data-dmo-live-tool="true">@anchor.LiveToolReference — lote @anchor.LiveToolLot@(anchor.Processo is null ? "" : $" ({anchor.Processo})")</dd></div>
                    }
                </dl>
            }

            @* Opening facts + manual % utilização (a NUMBER, never a progress bar; AC-U3) *@
            <dl class="dmo-boquilhas__facts" data-dmo-boquilhas-facts="true">
                <div class="dmo-boquilhas__fact"><dt>Data de abertura</dt><dd data-dmo-opening-date="true">@ficha.OpeningDate.ToString("yyyy-MM-dd")</dd></div>
                <div class="dmo-boquilhas__fact"><dt>Máquinas</dt><dd data-dmo-machines="true">@string.Join(", ", ficha.Machines)</dd></div>
                <div class="dmo-boquilhas__fact"><dt>Início</dt><dd data-dmo-inicio="true">@(fichaView.InitialQuantity)</dd></div>
                <div class="dmo-boquilhas__fact"><dt>% utilização</dt><dd data-dmo-utilisation="true">@(ficha.UtilisationPercent is { } utilisation ? utilisation.ToString("0.##") + "%" : "—")</dd></div>
                <div class="dmo-boquilhas__fact"><dt>Observações</dt><dd data-dmo-observations="true">@(ficha.Observations ?? "—")</dd></div>
            </dl>

            @* Opening-facts editing surface (aggregate context only; route 12; disabled when closed) *@
            <fieldset class="dmo-boquilhas__entry" data-dmo-opening-facts-edit="true" @(ficha.State == "closed" ? "disabled" : "")>
                <legend class="dmo-boquilhas__legend">Dados de abertura (editar)</legend>
                <label class="dmo-boquilhas__label" for="dmo-boquilhas-fact-date">Data de abertura</label>
                <input class="dmo-boquilhas__input" id="dmo-boquilhas-fact-date" type="date"
                       value="@ficha.OpeningDate.ToString("yyyy-MM-dd")" data-dmo-opening-fact-date="true" />
                <label class="dmo-boquilhas__label" for="dmo-boquilhas-fact-utilisation">% utilização (manual)</label>
                <input class="dmo-boquilhas__input" id="dmo-boquilhas-fact-utilisation" type="number" min="0" max="100" step="0.01"
                       value="@(ficha.UtilisationPercent?.ToString("0.##"))" data-dmo-opening-fact-utilisation="true" />
                <label class="dmo-boquilhas__label" for="dmo-boquilhas-fact-observations">Observações</label>
                <input class="dmo-boquilhas__input" id="dmo-boquilhas-fact-observations" type="text"
                       value="@(ficha.Observations ?? "")" data-dmo-opening-fact-observations="true" />
                <span class="dmo-boquilhas__label">Máquinas (substitui o conjunto registado)</span>
                <span class="dmo-boquilhas__machines">
                    @foreach (var machine in ficha.Machines)
                    {
                        <label class="dmo-boquilhas__machine">
                            <input type="checkbox" value="@machine" checked data-dmo-opening-fact-machine="@machine" />
                            @machine
                        </label>
                    }
                </span>
            </fieldset>

            @* Derived balance buckets (replay at read time; negative values visible, non-blocking; AC-B7) *@
            <dl class="dmo-boquilhas__balance" data-dmo-boquilhas-balance="true">
                <div class="dmo-boquilhas__fact"><dt>Disponível</dt><dd data-dmo-disponivel="true" class="@(ficha.Balance.Disponivel < 0 ? "dmo-boquilhas__negative" : "")">@ficha.Balance.Disponivel</dd></div>
                <div class="dmo-boquilhas__fact"><dt>Em reparação</dt><dd data-dmo-em-reparacao="true" class="@(ficha.Balance.EmReparacao < 0 ? "dmo-boquilhas__negative" : "")">@ficha.Balance.EmReparacao</dd></div>
                <div class="dmo-boquilhas__fact"><dt>Irreparável</dt><dd data-dmo-irreparavel="true">@ficha.Balance.Irreparavel</dd></div>
                <div class="dmo-boquilhas__fact"><dt>Entrada excecional</dt><dd data-dmo-entrada-excecional="true">@ficha.Balance.EntradaExcecional</dd></div>
            </dl>

            @* ---- R6 — Production-line contextual panel (read-only REAL context; never simulated) *@
            <div class="dmo-boquilhas__panel" data-dmo-boquilhas-panel="true" aria-label="Contexto de produção">
                @if (ficha.Production is { } production)
                {
                    <dl class="dmo-boquilhas__panel-facts">
                        <div class="dmo-boquilhas__fact"><dt>Referência</dt><dd data-dmo-panel-reference="true">@production.Reference</dd></div>
                        <div class="dmo-boquilhas__fact"><dt>Produção</dt><dd data-dmo-panel-production="true">@production.ProductionNumber</dd></div>
                        <div class="dmo-boquilhas__fact"><dt>Máquina</dt><dd data-dmo-panel-machine="true">@production.Machine</dd></div>
                    </dl>
                }
                else
                {
                    <p class="dmo-boquilhas__panel-standalone" data-dmo-panel-standalone="true">
                        Registo independente — máquinas registadas: @string.Join(", ", ficha.Machines)
                    </p>
                }
            </div>

            @* Movement ledger (single click selects; double click opens its edit/detail in R5) *@
            <div class="dmo-boquilhas__ledger-scroll" role="region" tabindex="0" aria-label="Movimentos">
                <table class="dmo-boquilhas__ledger" data-dmo-movement-table="true">
                    <thead>
                        <tr>
                            <th>Referência</th>
                            <th>Lote</th>
                            <th>Movimento</th>
                            <th>Quantidade</th>
                            <th>Saldo</th>
                            <th>Reparador</th>
                            <th>Linha</th>
                            <th>Data e hora</th>
                            <th>Operador</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var movement in ficha.Movements)
                        {
                            <tr tabindex="0"
                                data-dmo-movement-row="@movement.MovementId"
                                data-dmo-movement-type="@movement.MovementType"
                                data-dmo-movement-version="@movement.Version"
                                data-dmo-movement-quantity="@movement.Quantity"
                                data-dmo-movement-business-date="@movement.BusinessDate.ToString("yyyy-MM-dd")"
                                data-dmo-movement-machine="@(movement.Machine ?? "")"
                                data-dmo-movement-repairer="@(movement.RepairerId?.ToString() ?? "")"
                                data-dmo-movement-observations="@(movement.Observations ?? "")">
                                <td>@(ficha.Reference ?? "—")</td>
                                <td>@(ficha.Lot ?? "—")</td>
                                <td>@fichaView.Label(movement.MovementType)</td>
                                <td>@movement.Quantity</td>
                                <td class="@(movement.Saldo < 0 ? "dmo-boquilhas__negative" : "")">@movement.Saldo</td>
                                <td>@(movement.RepairerId?.ToString() ?? "—")</td>
                                <td>@(movement.Machine ?? "—")</td>
                                <td>@movement.BusinessDate.ToString("yyyy-MM-dd") · @movement.RecordedAt.ToString("HH:mm") UTC</td>
                                <td>@movement.RecordedByUserId</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @* ---- R3 — Movement entry (the selector exposes EXACTLY the four types; AC-V2) ---- *@
            <fieldset class="dmo-boquilhas__entry" data-dmo-movement-entry="true" @(ficha.State == "closed" ? "disabled" : "")>
                <legend class="dmo-boquilhas__legend">Registar movimento</legend>
                <label class="dmo-boquilhas__label" for="dmo-boquilhas-movement-type">Tipo</label>
                <select class="dmo-boquilhas__input" id="dmo-boquilhas-movement-type" data-dmo-movement-field="type">
                    <option value="inicio">Início</option>
                    <option value="saida">Saída</option>
                    <option value="entrada">Entrada</option>
                    <option value="irreparavel">Irreparável</option>
                </select>
                <label class="dmo-boquilhas__label" for="dmo-boquilhas-movement-quantity">Quantidade</label>
                <input class="dmo-boquilhas__input" id="dmo-boquilhas-movement-quantity" type="number" min="1" value="1"
                       data-dmo-movement-field="quantity" />
                <label class="dmo-boquilhas__label" for="dmo-boquilhas-movement-date">Data de negócio</label>
                <input class="dmo-boquilhas__input" id="dmo-boquilhas-movement-date" type="date"
                       value="@DateTime.Today.ToString("yyyy-MM-dd")" data-dmo-movement-field="businessDate" />
                <label class="dmo-boquilhas__label" for="dmo-boquilhas-movement-machine">Máquina</label>
                <select class="dmo-boquilhas__input" id="dmo-boquilhas-movement-machine" data-dmo-movement-field="machine">
                    <option value="">—</option>
                    @foreach (var machine in ficha.Machines)
                    {
                        <option value="@machine">@machine</option>
                    }
                </select>
                <label class="dmo-boquilhas__label" for="dmo-boquilhas-movement-repairer">Reparador</label>
                <select class="dmo-boquilhas__input" id="dmo-boquilhas-movement-repairer" data-dmo-movement-field="repairer">
                    <option value="">—</option>
                    @foreach (var repairer in Model.Entry?.Repairers ?? [])
                    {
                        <option value="@repairer.RepairerId">@repairer.Name</option>
                    }
                </select>
                <label class="dmo-boquilhas__label" for="dmo-boquilhas-movement-observations">Observações</label>
                <input class="dmo-boquilhas__input" id="dmo-boquilhas-movement-observations" type="text"
                       data-dmo-movement-field="observations" />
                @if (Model.Entry is { } entry)
                {
                    <div class="dmo-boquilhas__resolutions" data-dmo-resolutions="true" hidden>
                        @foreach (var assignment in entry.Assignments)
                        {
                            <span data-dmo-assignment="@assignment.Machine"
                                  data-dmo-assignment-repairer="@(assignment.RepairerId?.ToString() ?? "")"
                                  data-dmo-assignment-unavailable="@(assignment.AssignmentUnavailable.ToString().ToLowerInvariant())"></span>
                        }
                    </div>
                }
                <span class="dmo-boquilhas__actions">
                    <button type="button" class="dmo-boquilhas__button" data-dmo-movement-submit="true">Registar movimento</button>
                </span>
            </fieldset>

            @* ---- R4 — Action region (DecisionBar; actions outside every table) ---------------- *@
            <div class="dmo-boquilhas__region" data-dmo-boquilhas-region="actions" aria-label="Ações do registo">
                @if (Model.Actions is { } actions)
                {
                    ViewData["DecisionBarRegionId"] = "dmo-boquilhas-actions";
                    <partial name="~/Pages/Shared/Components/_DecisionBar.cshtml" model="actions" />
                }

                @* Reopen reason input (opened by the Reabrir action; mandatory non-blank reason) *@
                <div class="dmo-boquilhas__reason" data-dmo-reason-region="true" hidden>
                    <label class="dmo-boquilhas__label" for="dmo-boquilhas-reopen-reason">Motivo (obrigatório)</label>
                    <input class="dmo-boquilhas__input" id="dmo-boquilhas-reopen-reason" type="text"
                           data-dmo-reopen-reason-input="true" maxlength="2000" />
                </div>

                @* Page-owned failure surface (conflict = message + explicit reload recovery, D2) *@
                <div class="dmo-boquilhas__state" data-dmo-boquilhas-state="true" hidden></div>
            </div>
        </div>

        @* ---- R5 — Movement edit/detail (opened by double click on the ledger; AuditTrail) ---- *@
        @if (Model.Detail is { } detail)
        {
            <div class="dmo-boquilhas__region" data-dmo-boquilhas-region="detail" aria-label="Editar movimento"
                 data-dmo-edit-movement-id="@detail.Movement.MovementId"
                 data-dmo-edit-movement-version="@detail.Movement.Version">
                <h3 class="dmo-boquilhas__title">Editar movimento</h3>
                <dl class="dmo-boquilhas__facts">
                    <div class="dmo-boquilhas__fact"><dt>Movimento</dt><dd>@fichaView.Label(detail.Movement.MovementType)</dd></div>
                    <div class="dmo-boquilhas__fact"><dt>Registado em</dt><dd>@detail.Movement.RecordedAt.ToString("yyyy-MM-dd HH:mm") UTC</dd></div>
                    <div class="dmo-boquilhas__fact"><dt>Operador</dt><dd>@detail.Movement.RecordedByUserId</dd></div>
                </dl>
                <fieldset class="dmo-boquilhas__entry" data-dmo-edit-form="true" @(ficha.State == "closed" ? "disabled" : "")>
                    <label class="dmo-boquilhas__label" for="dmo-boquilhas-edit-quantity">Quantidade</label>
                    <input class="dmo-boquilhas__input" id="dmo-boquilhas-edit-quantity" type="number" min="1"
                           value="@detail.Movement.Quantity" data-dmo-edit-field="quantity" />
                    <label class="dmo-boquilhas__label" for="dmo-boquilhas-edit-date">Data de negócio</label>
                    <input class="dmo-boquilhas__input" id="dmo-boquilhas-edit-date" type="date"
                           value="@detail.Movement.BusinessDate.ToString("yyyy-MM-dd")" data-dmo-edit-field="businessDate" />
                    <label class="dmo-boquilhas__label" for="dmo-boquilhas-edit-machine">Máquina</label>
                    <select class="dmo-boquilhas__input" id="dmo-boquilhas-edit-machine" data-dmo-edit-field="machine">
                        <option value="">—</option>
                        @foreach (var machine in ficha.Machines)
                        {
                            <option value="@machine" selected="@(detail.Movement.Machine == machine)">@machine</option>
                        }
                    </select>
                    <label class="dmo-boquilhas__label" for="dmo-boquilhas-edit-repairer">Reparador</label>
                    <select class="dmo-boquilhas__input" id="dmo-boquilhas-edit-repairer" data-dmo-edit-field="repairer">
                        <option value="">—</option>
                        @foreach (var repairer in Model.Entry?.Repairers ?? [])
                        {
                            <option value="@repairer.RepairerId" selected="@(detail.Movement.RepairerId == repairer.RepairerId)">@repairer.Name</option>
                        }
                    </select>
                    <label class="dmo-boquilhas__label" for="dmo-boquilhas-edit-observations">Observações</label>
                    <input class="dmo-boquilhas__input" id="dmo-boquilhas-edit-observations" type="text"
                           value="@(detail.Movement.Observations ?? "")" data-dmo-edit-field="observations" />
                    <span class="dmo-boquilhas__actions">
                        <button type="button" class="dmo-boquilhas__button" data-dmo-edit-submit="true">Guardar edição</button>
                    </span>
                </fieldset>
                <div class="dmo-boquilhas__trail" data-dmo-audit-trail="true">
                    <partial name="~/Pages/Shared/Components/_AuditTrail.cshtml" model="detail.Trail" />
                </div>
            </div>
        }

        @* Page-owned adapter state: the REAL observed version (backend fact; refreshed only on success) *@
        <div class="dmo-boquilhas__adapter-state" hidden
             data-dmo-boquilhas-id="@ficha.BoquilhasId"
             data-dmo-version="@Model.ObservedVersion"></div>
    }
</section>