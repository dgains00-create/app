@page "/boquilhas/historico"
@model DMO.Web.Pages.Boquilhas.HistoricoModel
@using DMO.Web.Frontend.Shared.Contracts
@{
    ViewData["Title"] = "Boquilhas — Histórico";
    var movementFilterAll = string.IsNullOrWhiteSpace(Model.MovementType);
    var movementFilterSaida = Model.MovementType == "saida";
    var movementFilterEntrada = Model.MovementType == "entrada";
    var movementFilterSemReparacao = Model.MovementType == "entrada_sem_reparacao";
}
<partial name="~/Pages/Shared/Components/_SharedComponentAssets.cshtml" />
<link rel="stylesheet" href="~/css/dmo-boquilhas.css" asp-append-version="true" />
<script src="~/js/dmo-boquilhas.js" defer></script>

@*
    P2-T07 Histórico surface (OWNER CLARIFICATION).

    HISTÓRICO (local) inside the Boquilhas module — NEVER HISTÓRICO GLOBAL. Fixed desktop
    composition at the binding 1366 × 768 viewport; the wide history table uses local
    keyboard-reachable overflow; no breakpoint variant, no card conversion, no required-column
    hiding and no action relocation exists anywhere in this surface (AC-L1/L2).

    The history is the CHRONOLOGICAL MOVEMENT HISTORY of the production/BQ contexts: each row is
    one movement with its production context (reference/lot/production number), movement type,
    quantity, business_date, recorded_at, repairer, line and observations. Movement vocabulary:
    Saída, Entrada, Entrada sem reparação — no Início, no Irreparável, no active/closed/reopened
    state. Every filter is a backend SQL predicate (never client-side filtering of a fetched set);
    unknown/ill-formed values are refused with FILTER_INVALID. Paging is 1-based with the
    deterministic chronological order and the total is the backend count for the same predicate.
    The table is a selection surface: single click selects, double click opens the exact register
    (H3); no per-row action grid.
*@
<section class="dmo-boquilhas" data-dmo-boquilhas-surface="historico" data-dmo-boquilhas-root="true">

    @* ---- Filters (backend-applied) --------------------------------------------------------- *@
    <div class="dmo-boquilhas__region" data-dmo-boquilhas-region="filters" aria-label="Filtros">
        <form class="dmo-boquilhas__filters" method="get" action="/boquilhas/historico" data-dmo-boquilhas-filters="true">
            <label class="dmo-boquilhas__label" for="dmo-boquilhas-reference">Referência</label>
            <input class="dmo-boquilhas__input" id="dmo-boquilhas-reference" name="reference" type="text"
                   value="@Model.Reference" data-dmo-filter-reference="true" />
            <label class="dmo-boquilhas__label" for="dmo-boquilhas-lot">Lote</label>
            <input class="dmo-boquilhas__input" id="dmo-boquilhas-lot" name="lot" type="text"
                   value="@Model.Lot" data-dmo-filter-lot="true" />
            <label class="dmo-boquilhas__label" for="dmo-boquilhas-machine">Máquina</label>
            <input class="dmo-boquilhas__input" id="dmo-boquilhas-machine" name="machine" type="text"
                   value="@Model.Machine" data-dmo-filter-machine="true" />
            <label class="dmo-boquilhas__label" for="dmo-boquilhas-date-from">Data de negócio desde</label>
            <input class="dmo-boquilhas__input" id="dmo-boquilhas-date-from" name="businessDateFrom" type="date"
                   value="@(Model.BusinessDateFrom?.ToString("yyyy-MM-dd"))" data-dmo-filter-date-from="true" />
            <label class="dmo-boquilhas__label" for="dmo-boquilhas-date-to">Data de negócio até</label>
            <input class="dmo-boquilhas__input" id="dmo-boquilhas-date-to" name="businessDateTo" type="date"
                   value="@(Model.BusinessDateTo?.ToString("yyyy-MM-dd"))" data-dmo-filter-date-to="true" />
            <label class="dmo-boquilhas__label" for="dmo-boquilhas-movement-type">Movimento</label>
            <select class="dmo-boquilhas__input" id="dmo-boquilhas-movement-type" name="movementType" data-dmo-filter-movement-type="true">
                <option value="" selected="@movementFilterAll">Todos</option>
                <option value="saida" selected="@movementFilterSaida">Saída</option>
                <option value="entrada" selected="@movementFilterEntrada">Entrada</option>
                <option value="entrada_sem_reparacao" selected="@movementFilterSemReparacao">Entrada sem reparação</option>
            </select>
            <label class="dmo-boquilhas__label" for="dmo-boquilhas-repairer">Reparador</label>
            <input class="dmo-boquilhas__input" id="dmo-boquilhas-repairer" name="repairerId" type="text"
                   value="@(Model.RepairerId?.ToString())" data-dmo-filter-repairer="true" />
            <button class="dmo-boquilhas__button" type="submit" data-dmo-boquilhas-filter-submit="true">Filtrar</button>
        </form>

        @if (Model.ValidationErrors.Count > 0)
        {
            <ul class="dmo-boquilhas__errors" role="alert" data-dmo-boquilhas-errors="true">
                @foreach (var error in Model.ValidationErrors)
                {
                    <li data-dmo-boquilhas-error="@error">@error</li>
                }
            </ul>
        }

        @if (Model.History is { } history)
        {
            <div class="dmo-boquilhas__route-map" data-dmo-open-route-map="true" hidden>
                @foreach (var route in Model.OpenRoutes)
                {
                    <span data-dmo-open-route="@route.Key" data-dmo-open-href="@route.Href"></span>
                }
            </div>
            <partial name="~/Pages/Shared/Components/_DenseDataTable.cshtml" model="history" />
        }
        else if (Model.ValidationErrors.Count == 0)
        {
            <p class="dmo-boquilhas__empty" data-dmo-boquilhas-empty="true">Sem movimentos no Histórico para os filtros indicados.</p>
        }
    </div>

    @* ---- Register detail (opened by double click on the history row) ----------------------- *@
    @if (Model.Register is { } registerView)
    {
        var ficha = registerView.Ficha;

        <div class="dmo-boquilhas__region" data-dmo-boquilhas-region="detail" aria-label="Registo"
             data-dmo-boquilhas-id="@ficha.BoquilhasId">
            <h2 class="dmo-boquilhas__title">
                Boquilhas @ficha.BoquilhasId — @(ficha.Reference ?? "(sem contexto)")
            </h2>

            <dl class="dmo-boquilhas__panel-facts" data-dmo-boquilhas-panel="true" aria-label="Contexto de produção">
                @if (ficha.Production is { } production)
                {
                    <div class="dmo-boquilhas__fact"><dt>Referência</dt><dd data-dmo-panel-reference="true">@production.Reference</dd></div>
                    <div class="dmo-boquilhas__fact"><dt>Produção</dt><dd data-dmo-panel-production="true">@production.ProductionNumber</dd></div>
                    <div class="dmo-boquilhas__fact"><dt>Máquina</dt><dd data-dmo-panel-machine="true">@production.Machine</dd></div>
                    <div class="dmo-boquilhas__fact"><dt>Data de produção</dt><dd data-dmo-panel-production-date="true">@(production.ProductionDate?.ToString("yyyy-MM-dd") ?? "—")</dd></div>
                }
                <div class="dmo-boquilhas__fact"><dt>Pendente de reparação</dt><dd data-dmo-outstanding="true" class="@(ficha.Outstanding < 0 ? "dmo-boquilhas__negative" : "")">@ficha.Outstanding</dd></div>
            </dl>

            <div class="dmo-boquilhas__ledger-scroll" role="region" tabindex="0" aria-label="Movimentos">
                <table class="dmo-boquilhas__ledger" data-dmo-movement-table="true">
                    <thead>
                        <tr>
                            <th>Movimento</th>
                            <th>Quantidade</th>
                            <th>Data de negócio</th>
                            <th>Registado em</th>
                            <th>Reparador</th>
                            <th>Linha</th>
                            <th>Observações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var movement in ficha.Movements)
                        {
                            <tr data-dmo-movement-row="@movement.MovementId" data-dmo-movement-type="@movement.MovementType">
                                <td>@registerView.Label(movement.MovementType)</td>
                                <td>@movement.Quantity</td>
                                <td>@movement.BusinessDate.ToString("yyyy-MM-dd")</td>
                                <td>@movement.RecordedAt.ToString("yyyy-MM-dd HH:mm") UTC</td>
                                <td>@(movement.RepairerId?.ToString() ?? "—")</td>
                                <td>@(movement.Machine ?? "—")</td>
                                <td>@(movement.Observations ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @* Page-owned failure surface (conflict = message + explicit reload recovery, D2) *@
            <div class="dmo-boquilhas__state" data-dmo-boquilhas-state="true" hidden></div>
        </div>
    }
</section>